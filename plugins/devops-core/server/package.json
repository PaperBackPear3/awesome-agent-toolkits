{
  "name": "devops-core-mcp",
  "version": "1.0.0",
  "description": "MCP server for guided EKS and AKS cluster upgrade workflows",
  "type": "module",
  "bin": {
    "devops-core-mcp": "bundle.mjs"
  },
  "files": [
    "bundle.mjs",
    "dist/"
  ],
  "scripts": {
    "build:ui": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --banner:js='#!/usr/bin/env node' --outfile=bundle.mjs",
    "build": "npm run build:ui && npm run build:server",
    "dev": "docker-compose up",
    "dev:local": "npx tsx server.ts",
    "start": "node bundle.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "kubernetes", "eks", "aks", "devops", "claude"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaperBackPear3/awesome-agent-toolkits"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.0",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-singlefile": "latest"
  }
}
